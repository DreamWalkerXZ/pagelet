          {
            "bearerAuth": [

            ]
          },
          {
            "sessionAuth": [

            ]
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "$ref": "#/components/parameters/CsrfHeader"
          }
        ],
        "responses": {
