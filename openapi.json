    "/_/api/v1/login": {
      "post": {
        "operationId": "login",
        "security": [

        ],
        "parameters": [
          {
            "name": "X-Pagelet-CSRF",
            "in": "header",
            "schema": {
              "type": "string",
              "const": "1"
            },
            "description": "Required for login and all cookie-authenticated mutations; bearer requests do not require this header. No cross-origin CORS permission is granted."
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid credentials"
          },
          "403": {
            "description": "Permission or CSRF header required"
          },
          "404": {
            "description": "Target user not found"
          },
          "409": {
            "description": "Credentials changed concurrently; retry"
          },
          "422": {
            "description": "Malformed JSON body"
          },
          "500": {
            "description": "Internal persistence error"
          },
          "200": {
            "description": "Credential operation completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResult"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "pagelet_session opaque credential; Path=/; HttpOnly; SameSite=Lax; Max-Age=604800. Fixed absolute server expiry without renewal."
              }
            }
          },
          "429": {
            "description": "10 attempts per 60 seconds per direct source IP and target account; process-local counters reset on restart."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "description": "Login requires X-Pagelet-CSRF: 1 even without an existing session. Logout revokes only the current browser session."
      }
    },
