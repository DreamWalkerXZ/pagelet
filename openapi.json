  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "pagelet_session",
        "description": "HttpOnly, SameSite=Lax, fixed seven-day expiry; API tokens are separate."
      },
      "pageGrant": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Pagelet-Grant",
        "description": "A page-specific 24-hour visitor grant. Browser cookies are named pagelet_grant_{immutable_page_id}; HttpOnly, SameSite=Lax, Path=/."
      }
    },
    "schemas": {
      "Account": {
        "type": "object",
        "required": [
          "id",
          "username",
          "role"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "administrator",
              "user"
            ]
          }
        }
      },
      "CreateUser": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password",
          "role"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 32,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "description": "Unicode characters, preserving spaces without trimming or normalization. Stored as an irreversible verifier.",
            "writeOnly": true
          },
          "role": {
            "type": "string",
            "enum": [
              "administrator",
              "user"
            ]
          }
        }
      },
      "CreatedUser": {
        "type": "object",
        "required": [
          "user",
          "token"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/Account"
          },
          "token": {
            "type": "string",
            "description": "Full-permission bearer token disclosed once."
          }
        }
      },
      "UserList": {
        "type": "object",
        "required": [
          "users",
          "total",
          "page",
          "per_page"
        ],
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Account"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          }
        }
      },
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "writeOnly": true
          }
        }
      },
      "PasswordChange": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "password",
          "current_password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "description": "Unicode characters, preserving spaces without trimming or normalization. Stored as an irreversible verifier.",
            "writeOnly": true
          },
          "current_password": {
            "type": "string",
            "writeOnly": true
          }
        }
      },
      "PasswordReset": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "description": "Unicode characters, preserving spaces without trimming or normalization. Stored as an irreversible verifier.",
            "writeOnly": true
          },
          "current_password": {
            "type": "string",
            "writeOnly": true
          }
        }
      },
      "IssuedToken": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "Replacement API token. Save now; never retrievable again."
          }
        }
      },
      "LoginResult": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer"
          }
        }
      },
      "PageMetadata": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "owner_id",
          "created_at",
          "updated_at",
          "version"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "Immutable page identifier"
          },
          "slug": {
            "type": "string"
          },
          "owner_id": {
            "type": "integer"
          },
          "created_at": {
            "type": "integer",
            "description": "Unix milliseconds"
          },
          "updated_at": {
            "type": "integer",
            "description": "Unix milliseconds"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Page": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "owner_id",
          "created_at",
          "updated_at",
          "version",
          "markdown"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "Immutable page identifier"
          },
          "slug": {
            "type": "string"
          },
          "owner_id": {
            "type": "integer"
          },
          "created_at": {
            "type": "integer",
            "description": "Unix milliseconds"
          },
          "updated_at": {
            "type": "integer",
            "description": "Unix milliseconds"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "markdown": {
            "type": "string"
          }
        }
      },
      "CreatePage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "markdown"
        ],
        "properties": {
          "markdown": {
            "type": "string",
            "description": "Valid UTF-8, up to 1048576 bytes; empty content is published immediately."
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Omit for a random 12-character lowercase alphanumeric slug. Collisions are retried."
          },
          "access_password": {
            "type": "string",
            "maxLength": 128,
            "description": "Exact Unicode characters, without trimming or normalization. Empty string removes protection; omission preserves the current policy on edits."
          }
        }
      },
      "PageList": {
        "type": "object",
        "required": [
          "pages",
          "total",
          "page",
          "per_page"
        ],
        "properties": {
          "pages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PageMetadata"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          }
        }
      },
      "EditPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "markdown": {
            "type": "string",
            "description": "Valid UTF-8, up to 1048576 bytes; empty content is published immediately."
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "access_password": {
            "type": "string",
            "maxLength": 128,
            "description": "Exact Unicode characters, without trimming or normalization. Empty string removes protection; omission preserves the current policy on edits."
          }
        },
        "description": "Provide at least one of markdown, slug, or access_password. Every successful mutation advances the version; password changes and removal revoke all page grants."
      },
      "DeletePage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "PasswordRequired": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "const": "password_required"
          }
        }
      },
      "VerifyPagePassword": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "PageGrant": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grant",
          "expires_at"
        ],
        "properties": {
          "grant": {
            "type": "string",
            "description": "Read-only credential for X-Pagelet-Grant; revealed only at issuance."
          },
          "expires_at": {
            "type": "integer",
            "description": "Absolute Unix timestamp in seconds, 24 hours after verification."
          }
        }
      },
      "TransferOwnership": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "owner_id"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "owner_id": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "parameters": {
      "CsrfHeader": {
        "name": "X-Pagelet-CSRF",
        "in": "header",
        "required": false,
        "description": "Required with value 1 for cookie-authenticated mutations; bearer authentication does not require it.",
        "schema": {
          "type": "string",
          "const": "1"
        }
      }
    }
  }
}
