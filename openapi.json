            "description": "Invalid JSON or parameters"
          },
          "409": {
            "description": "Stale page version; no changes applied",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
