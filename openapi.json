  "info": {
    "title": "Pagelet API",
    "description": "HTTPS deployment uses an explicit external URL for Secure cookies and trusted proxy IP/CIDRs for effective source-IP limits. Untrusted forwarding headers are ignored. Malformed trusted X-Forwarded-For chains return 400 on login/password verification; source and target limits both apply. See README for proxy and CSRF configuration.",
    "version": "1.0.0"
  },
