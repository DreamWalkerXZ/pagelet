{
  "openapi": "3.1.0",
  "info": {"title": "Pagelet API", "version": "1.0.0"},
  "paths": {
    "/_/api/v1/me": {"get": {
      "operationId": "getCurrentAccount",
      "security": [{"bearerAuth": []}],
      "responses": {
        "200": {"description": "Current account, without stored credentials", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Account"}}}},
        "401": {"description": "Missing or invalid bearer token"},
        "500": {"description": "Internal persistence error"}
      }
    }},
    "/_/openapi.json": {"get": {"operationId": "getOpenApi", "responses": {"200": {"description": "Public OpenAPI contract", "content": {"application/json": {"schema": {"type": "object"}}}}}}}
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer"}},
    "schemas": {"Account": {"type": "object", "required": ["id", "username", "role"], "properties": {"id": {"type": "integer"}, "username": {"type": "string"}, "role": {"type": "string", "enum": ["administrator", "user"]}}}}
  }
}
