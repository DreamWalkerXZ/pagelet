{
  "openapi": "3.1.0",
  "info": {
    "title": "Pagelet API",
    "version": "1.0.0"
  },
  "paths": {
    "/_/api/v1/me": {
      "get": {
        "operationId": "getCurrentAccount",
        "security": [
          {
            "bearerAuth": [

            ]
          },
          {
            "sessionAuth": [

            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Current account, without stored credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "500": {
            "description": "Internal persistence error"
          }
        },
        "parameters": [

        ]
      }
    },
    "/_/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "responses": {
          "200": {
            "description": "Public OpenAPI contract",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/_/api/v1/users": {
      "post": {
        "operationId": "createUser",
        "description": "Administrator-only provisioning. Username and role are immutable; no public registration. Issues exactly one full-permission token, disclosed only in this response.",
        "security": [
          {
            "bearerAuth": [

            ]
          },
          {
            "sessionAuth": [

            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUser"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created account and one-time token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedUser"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or parameters"
          },
          "401": {
            "description": "Missing or invalid authentication"
          },
          "403": {
            "description": "Administrator permission required"
          },
          "500": {
            "description": "Internal persistence error"
          },
          "409": {
            "description": "Username already exists"
          }
        },
        "parameters": [
          {
            "name": "X-Pagelet-CSRF",
            "in": "header",
            "schema": {
              "type": "string",
              "const": "1"
            },
            "description": "Required for login and all cookie-authenticated mutations; bearer requests do not require this header. No cross-origin CORS permission is granted."
          }
        ]
      },
      "get": {
        "operationId": "listUsers",
        "description": "Administrator-only literal case-sensitive username substring search, ordered by username then ID. No credentials returned.",
        "security": [
          {
            "bearerAuth": [

            ]
          },
          {
            "sessionAuth": [

            ]
          }
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 20,
              "description": "Values above 100 are capped at 100."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated account metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or parameters"
          },
          "401": {
            "description": "Missing or invalid authentication"
          },
          "403": {
            "description": "Administrator permission required"
          },
          "500": {
            "description": "Internal persistence error"
          }
        }
      }
    },
    "/_/api/v1/login": {
      "post": {
        "operationId": "login",
        "security": [

        ],
        "parameters": [
          {
            "name": "X-Pagelet-CSRF",
            "in": "header",
            "schema": {
              "type": "string",
              "const": "1"
            },
            "description": "Required for login and all cookie-authenticated mutations; bearer requests do not require this header. No cross-origin CORS permission is granted."
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid credentials"
          },
          "403": {
            "description": "Permission or CSRF header required"
          },
          "404": {
            "description": "Target user not found"
          },
          "409": {
            "description": "Credentials changed concurrently; retry"
          },
          "422": {
            "description": "Malformed JSON body"
          },
          "500": {
            "description": "Internal persistence error"
          },
          "200": {
            "description": "Credential operation completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResult"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "pagelet_session opaque credential; Path=/; HttpOnly; SameSite=Lax; Max-Age=604800. Fixed absolute server expiry without renewal."
              }
            }
          },
          "429": {
            "description": "10 attempts per 60 seconds per direct source IP and target account; process-local counters reset on restart."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "description": "Login requires X-Pagelet-CSRF: 1 even without an existing session. Logout revokes only the current browser session."
      }
    },
    "/_/api/v1/logout": {
      "post": {
        "operationId": "logout",
        "security": [
          {
            "bearerAuth": [

            ]
          },
          {
            "sessionAuth": [

            ]
          }
        ],
        "parameters": [
          {
            "name": "X-Pagelet-CSRF",
            "in": "header",
            "schema": {
              "type": "string",
              "const": "1"
            },
            "description": "Required for login and all cookie-authenticated mutations; bearer requests do not require this header. No cross-origin CORS permission is granted."
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid credentials"
          },
          "403": {
            "description": "Permission or CSRF header required"
          },
          "404": {
            "description": "Target user not found"
          },
          "409": {
            "description": "Credentials changed concurrently; retry"
          },
          "422": {
            "description": "Malformed JSON body"
          },
          "500": {
            "description": "Internal persistence error"
          },
          "204": {
            "description": "Current browser session revoked"
          }
        },
        "description": "Login requires X-Pagelet-CSRF: 1 even without an existing session. Logout revokes only the current browser session."
      }
    },
    "/_/api/v1/me/password": {
      "post": {
        "operationId": "changePassword",
        "security": [
          {
            "bearerAuth": [

            ]
          },
          {
            "sessionAuth": [

            ]
          }
        ],
        "parameters": [
          {
            "name": "X-Pagelet-CSRF",
            "in": "header",
            "schema": {
              "type": "string",
              "const": "1"
            },
            "description": "Required for login and all cookie-authenticated mutations; bearer requests do not require this header. No cross-origin CORS permission is granted."
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid credentials"
          },
          "403": {
            "description": "Permission or CSRF header required"
          },
          "404": {
            "description": "Target user not found"
          },
          "409": {
            "description": "Credentials changed concurrently; retry"
          },
          "422": {
            "description": "Malformed JSON body"
          },
          "500": {
            "description": "Internal persistence error"
          },
          "200": {
            "description": "Credential operation completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedToken"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordChange"
              }
            }
          }
        },
        "description": "Self change requires current_password. Administrator target reset requires administrator permission. Password changes rotate API token and revoke every account session atomically."
      }
    },
    "/_/api/v1/me/token": {
      "post": {
        "operationId": "resetOwnToken",
        "security": [
          {
            "bearerAuth": [

            ]
          },
          {
            "sessionAuth": [

            ]
          }
        ],
        "parameters": [
          {
            "name": "X-Pagelet-CSRF",
            "in": "header",
            "schema": {
              "type": "string",
              "const": "1"
            },
            "description": "Required for login and all cookie-authenticated mutations; bearer requests do not require this header. No cross-origin CORS permission is granted."
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid credentials"
          },
          "403": {
            "description": "Permission or CSRF header required"
          },
          "404": {
            "description": "Target user not found"
          },
          "409": {
            "description": "Credentials changed concurrently; retry"
          },
          "422": {
            "description": "Malformed JSON body"
          },
          "500": {
            "description": "Internal persistence error"
          },
          "200": {
            "description": "Credential operation completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedToken"
                }
              }
            }
          }
        },
        "description": "Self or administrator target reset; immediately revokes the previous API token, preserves browser sessions. Token has no automatic expiry."
      }
    },
    "/_/api/v1/users/{id}/password": {
      "post": {
        "operationId": "resetUserPassword",
        "security": [
          {
            "bearerAuth": [

            ]
          },
          {
            "sessionAuth": [

            ]
          }
        ],
        "parameters": [
          {
            "name": "X-Pagelet-CSRF",
            "in": "header",
            "schema": {
              "type": "string",
              "const": "1"
            },
            "description": "Required for login and all cookie-authenticated mutations; bearer requests do not require this header. No cross-origin CORS permission is granted."
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid credentials"
          },
          "403": {
            "description": "Permission or CSRF header required"
          },
          "404": {
            "description": "Target user not found"
          },
          "409": {
            "description": "Credentials changed concurrently; retry"
          },
          "422": {
            "description": "Malformed JSON body"
          },
          "500": {
            "description": "Internal persistence error"
          },
          "200": {
            "description": "Credential operation completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedToken"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordReset"
              }
            }
          }
        },
        "description": "Self change requires current_password. Administrator target reset requires administrator permission. Password changes rotate API token and revoke every account session atomically."
      }
    },
    "/_/api/v1/users/{id}/token": {
      "post": {
        "operationId": "resetUserToken",
        "security": [
          {
            "bearerAuth": [

            ]
          },
          {
            "sessionAuth": [

            ]
          }
        ],
        "parameters": [
          {
            "name": "X-Pagelet-CSRF",
            "in": "header",
            "schema": {
              "type": "string",
              "const": "1"
            },
            "description": "Required for login and all cookie-authenticated mutations; bearer requests do not require this header. No cross-origin CORS permission is granted."
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid credentials"
          },
          "403": {
            "description": "Permission or CSRF header required"
          },
          "404": {
            "description": "Target user not found"
          },
          "409": {
            "description": "Credentials changed concurrently; retry"
          },
          "422": {
            "description": "Malformed JSON body"
          },
          "500": {
            "description": "Internal persistence error"
          },
          "200": {
            "description": "Credential operation completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedToken"
                }
              }
            }
          }
        },
        "description": "Self or administrator target reset; immediately revokes the previous API token, preserves browser sessions. Token has no automatic expiry."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "pagelet_session",
        "description": "HttpOnly, SameSite=Lax, fixed seven-day expiry; API tokens are separate."
      }
    },
    "schemas": {
      "Account": {
        "type": "object",
        "required": [
          "id",
          "username",
          "role"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "administrator",
              "user"
            ]
          }
        }
      },
      "CreateUser": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password",
          "role"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 32,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "description": "Unicode characters, preserving spaces without trimming or normalization. Stored as an irreversible verifier.",
            "writeOnly": true
          },
          "role": {
            "type": "string",
            "enum": [
              "administrator",
              "user"
            ]
          }
        }
      },
      "CreatedUser": {
        "type": "object",
        "required": [
          "user",
          "token"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/Account"
          },
          "token": {
            "type": "string",
            "description": "Full-permission bearer token disclosed once."
          }
        }
      },
      "UserList": {
        "type": "object",
        "required": [
          "users",
          "total",
          "page",
          "per_page"
        ],
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Account"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          }
        }
      },
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "writeOnly": true
          }
        }
      },
      "PasswordChange": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "password",
          "current_password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "description": "Unicode characters, preserving spaces without trimming or normalization. Stored as an irreversible verifier.",
            "writeOnly": true
          },
          "current_password": {
            "type": "string",
            "writeOnly": true
          }
        }
      },
      "PasswordReset": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "description": "Unicode characters, preserving spaces without trimming or normalization. Stored as an irreversible verifier.",
            "writeOnly": true
          },
          "current_password": {
            "type": "string",
            "writeOnly": true
          }
        }
      },
      "IssuedToken": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "Replacement API token. Save now; never retrievable again."
          }
        }
      },
      "LoginResult": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer"
          }
        }
      }
    }
  }
}
