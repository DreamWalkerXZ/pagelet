            },
            "description": "Required with value 1 for cookie-authenticated mutations."
          }
        ]
      }
    },
    "/_/api/v1/pages/by-slug/{slug}/verify-password": {
      "post": {
        "operationId": "verifyPagePassword",
        "description": "Rate limited to ten attempts per source and per immutable page within 60 seconds; process-local counters reset on restart. Correct password returns a 24-hour grant and sets a per-page HttpOnly cookie. Cache-Control: no-store. Password changes/removal, deletion, and ownership transfer revoke grants. Access changes cannot recall previously delivered content.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyPagePassword"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Read-only page access grant and HttpOnly cookie.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "pagelet_grant_{page_id}=...; Path=/; HttpOnly; SameSite=Lax; Max-Age=86400 (Secure when the external URL uses HTTPS)"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageGrant"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or page has no access password"
          },
          "401": {
            "description": "Incorrect password or policy changed during verification"
          },
          "404": {
            "description": "Page not found"
          },
          "429": {
            "description": "Source or page attempt limit exceeded; retry after the 60-second window"
          },
          "500": {
            "description": "Internal persistence error"
          }
        }
      }
    },
    "/_/api/v1/users/{id}": {
      "delete": {
        "operationId": "deleteUser",
        "summary": "Delete a page-free account and revoke its credentials and sessions; the final administrator is protected",
